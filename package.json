{
  "name": "pokeguru",
  "version": "0.3.9",
  "private": true,
  "desktopName": "io.github.xmey95.pokeguru.desktop",
  "description": "Progetti locali per mazzi Pokémon TCG",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "brand:generate": "node scripts/generate-brand.mjs",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "package:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:mac": "npm run build && node scripts/stage-mac-codex.mjs && electron-builder --mac --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "test": "vitest run",
    "test:e2e": "npm run build && node tests/electron-smoke.mjs",
    "test:e2e:offline": "npm run build && node tests/electron-smoke.mjs --offline",
    "test:workspace-ui": "npm run build && node tests/workspace-ui-live.mjs",
    "test:performance:growth": "npm run build && node tests/growth-performance-live.mjs",
    "test:reconciliation-live": "npm run build && node tests/reconciliation-live.mjs",
    "test:export-live": "npm run build && node tests/export-live.mjs",
    "test:threads-live": "npm run build && node tests/threads-live.mjs",
    "test:deck-adoption": "npm run build && node tests/deck-adoption-live.mjs",
    "test:rule-audit-live": "npm run build && node tests/rule-audit-live.mjs",
    "test:threads-ai:offline": "npm run build && node tests/threads-ai-live.mjs --offline",
    "test:threads-ai-live": "npm run build && node tests/threads-ai-live.mjs",
    "test:reconciliation-ai-live": "npm run build && node tests/reconciliation-ai-live.mjs",
    "test:ai-live": "npm run build && node tests/ai-settings-live.mjs",
    "test:ai:offline": "npm run build && node tests/ai-settings-offline.mjs",
    "test:codex-app-server-live": "node tests/codex-app-server-live.mjs",
    "test:matchup-live": "npm run build && node tests/matchup-live.mjs",
    "test:matchup-evidence-live": "npm run build && node tests/matchup-evidence-live.mjs",
    "test:standard-catalog-live": "npm run build && node tests/standard-catalog-electron-live.mjs",
    "test:catalog-ui": "npm run build && node tests/catalog-ui-live.mjs",
    "test:tournament-ui-live": "npm run build && node tests/tournament-ui-live.mjs",
    "test:tournament-ui:offline": "npm run build && node tests/tournament-ui-live.mjs --offline",
    "test:main-tournament-ui-live": "npm run build && node tests/main-tournament-ui-live.mjs"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@openai/codex": "0.164.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
